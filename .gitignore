# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase - contains API keys and project credentials
google-services.json
GoogleService-Info.plist
#firebase_options.dart

# Android local properties - may contain Google Maps / SDK keys
local.properties

# Environment variable files - Stripe keys, Google Maps keys, etc.
.env
.env.*
!.env.example

# Firebase Functions local secrets (Stripe sk_ / whsec_) — 絶対にコミットしない
functions/.secret.local
functions/.secret*.local

# Firebase deploy キャッシュ（自動生成・コミット不要）
.firebase/

# エミュレータの export データ（--export-on-exit 等で生成。ローカル検証用・コミット不要）
emulator-data/

# Secret / key files
**/secrets.dart
**/api_keys.dart
**/keys.dart
lib/config/secrets*.dart

# Claude Code instruction files (not deliverables)
claude_code_instruction_*.md

# Windows / WSL Zone.Identifier artifacts
*:Zone.Identifier

# 作業用バックアップ（ドキュメント編集時の退避ファイル）
*.bak_*

# 照合用の設計書・仕様書（.docx）。手元で参照するだけの資料でコミット対象外。
# 1ファイル数MBあり、リポジトリを不必要に肥大させるため除外する。
*.docx
